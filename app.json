{
  "expo": {
    "name": "xpence-app",
    "slug": "xpence-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xpenceapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.xpenceapp"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.xpenceapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51cc42b1-ad30-4633-8f82-65180546c727"
      }
    }
  }
}
